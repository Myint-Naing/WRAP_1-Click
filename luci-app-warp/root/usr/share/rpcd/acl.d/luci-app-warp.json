{
	"luci-app-warp": {
		"description": "Grant execution and access for LuCI Cloudflare WARP App",
		"read": {
			"uci": [ "warp" ],
			"ubus": {
				"network.interface.warp": [ "status" ]
			},
			"file": {
				"/usr/bin/warp-script": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "warp" ],
			"file": {
				"/usr/bin/warp-script": [ "exec" ]
			}
		}
	}
}
