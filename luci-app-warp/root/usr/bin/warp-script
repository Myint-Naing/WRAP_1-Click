#!/bin/sh
# /usr/bin/warp-script - Backend script for 1-Click Cloudflare WARP WireGuard integration

WARP_API_URL="https://api.cloudflareclient.com/v0a737/reg"
WARP_DEVICE_TYPE="Linux"
WARP_LOCALE="en_US"

log() {
	logger -t "warp-script" "$*"
	echo "[warp-script] $*"
}

json_extract() {
	local json="$1"
	local expr="$2"
	if command -v jsonfilter >/dev/null 2>&1; then
		echo "$json" | jsonfilter -e "$expr" 2>/dev/null
	elif command -v jq >/dev/null 2>&1; then
		local jq_expr
		jq_expr=$(echo "$expr" | sed 's/^\$//')
		echo "$json" | jq -r "$jq_expr // empty" 2>/dev/null
	fi
}

check_dependencies() {
	local missing=""
	for cmd in wg curl; do
		if ! command -v "$cmd" >/dev/null 2>&1; then
			missing="$missing $cmd"
		fi
	done
	if ! command -v jsonfilter >/dev/null 2>&1 && ! command -v jq >/dev/null 2>&1; then
		missing="$missing jsonfilter/jq"
	fi
	if [ -n "$missing" ]; then
		log "Error: Missing required packages:$missing"
		return 1
	fi
	return 0
}

configure_firewall() {
	log "Configuring firewall WAN zone..."
	local zone_section=""
	local idx=0
	while true; do
		local name
		name=$(uci -q get firewall.@zone[$idx].name)
		[ -z "$name" ] && break
		if [ "$name" = "wan" ]; then
			zone_section="@zone[$idx]"
			break
		fi
		idx=$((idx + 1))
	done

	if [ -n "$zone_section" ]; then
		uci del_list firewall.${zone_section}.network='warp' 2>/dev/null || true
		uci add_list firewall.${zone_section}.network='warp'
		uci commit firewall
		/etc/init.d/firewall reload >/dev/null 2>&1 || true
		log "Added 'warp' to firewall zone 'wan'"
	else
		log "Warning: 'wan' firewall zone not found"
	fi
}

remove_firewall() {
	log "Removing warp from firewall..."
	local idx=0
	while true; do
		local name
		name=$(uci -q get firewall.@zone[$idx].name)
		[ -z "$name" ] && break
		if [ "$name" = "wan" ]; then
			uci del_list firewall.@zone[$idx].network='warp' 2>/dev/null || true
		fi
		idx=$((idx + 1))
	done
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1 || true
}

do_register() {
	check_dependencies || exit 1

	log "Generating WireGuard keypair..."
	PRIVATE_KEY=$(wg genkey)
	PUBLIC_KEY=$(echo "$PRIVATE_KEY" | wg pubkey)

	if [ -z "$PRIVATE_KEY" ] || [ -z "$PUBLIC_KEY" ]; then
		log "Error: Failed to generate WireGuard keypair"
		exit 1
	fi

	TOS_DATE=$(date -u +"%Y-%m-%dT%H:%M:%S.000+00:00" 2>/dev/null || date -u +"%Y-%m-%dT%H:%M:%SZ")

	PAYLOAD=$(cat <<EOF
{
	"key": "$PUBLIC_KEY",
	"install_id": "",
	"warp_enabled": true,
	"tos": "$TOS_DATE",
	"type": "$WARP_DEVICE_TYPE",
	"locale": "$WARP_LOCALE"
}
EOF
)

	log "Registering with Cloudflare WARP API..."
	RESPONSE=$(curl -sS -f -X POST \
		-H "Content-Type: application/json" \
		-H "User-Agent: okhttp/3.12.1" \
		-d "$PAYLOAD" \
		"$WARP_API_URL" 2>&1)

	CURL_RET=$?
	if [ $CURL_RET -ne 0 ] || [ -z "$RESPONSE" ]; then
		log "Error registering with WARP API: $RESPONSE"
		exit 1
	fi

	PEER_PUBLIC_KEY=$(json_extract "$RESPONSE" '$.config.peers[0].public_key')
	INTERFACE_IPV4=$(json_extract "$RESPONSE" '$.config.interface.addresses.v4')
	INTERFACE_IPV6=$(json_extract "$RESPONSE" '$.config.interface.addresses.v6')
	ENDPOINT_HOST=$(json_extract "$RESPONSE" '$.config.peers[0].endpoint.host')
	ACCOUNT_ID=$(json_extract "$RESPONSE" '$.account.id')
	DEVICE_ID=$(json_extract "$RESPONSE" '$.id')
	LICENSE_KEY=$(json_extract "$RESPONSE" '$.account.license')
	CREATED_AT=$(json_extract "$RESPONSE" '$.created')
	EXPIRES_AT=$(json_extract "$RESPONSE" '$.account.ttl')

	if [ -z "$PEER_PUBLIC_KEY" ] || [ -z "$INTERFACE_IPV4" ]; then
		log "Error: Failed to parse Cloudflare WARP API response"
		log "Response: $RESPONSE"
		exit 1
	fi

	if [ -z "$ENDPOINT_HOST" ]; then
		ENDPOINT_HOST="engage.cloudflareclient.com:2408"
	fi

	ENDPOINT_IP="${ENDPOINT_HOST%:*}"
	ENDPOINT_PORT="${ENDPOINT_HOST##*:}"
	[ "$ENDPOINT_PORT" = "$ENDPOINT_IP" ] && ENDPOINT_PORT="2408"

	NOW=$(date +%s)
	CREATED_AT_EPOCH=""
	if [ -n "$CREATED_AT" ]; then
		CREATED_AT_CLEAN=$(echo "$CREATED_AT" | sed 's/T/ /; s/\..*//; s/Z//')
		CREATED_AT_EPOCH=$(date -u -d "$CREATED_AT_CLEAN" +%s 2>/dev/null || date -u -d "$CREATED_AT" +%s 2>/dev/null)
	fi
	[ -z "$CREATED_AT_EPOCH" ] && CREATED_AT_EPOCH="$NOW"

	EXPIRES_AT_EPOCH=""
	if [ -n "$EXPIRES_AT" ]; then
		EXPIRES_AT_CLEAN=$(echo "$EXPIRES_AT" | sed 's/T/ /; s/\..*//; s/Z//')
		EXPIRES_AT_EPOCH=$(date -u -d "$EXPIRES_AT_CLEAN" +%s 2>/dev/null || date -u -d "$EXPIRES_AT" +%s 2>/dev/null)
	fi
	# Default WARP key TTL is ~30 days (2592000 seconds) if unspecified
	if [ -z "$EXPIRES_AT_EPOCH" ] || [ "$EXPIRES_AT_EPOCH" -le "$NOW" ]; then
		EXPIRES_AT_EPOCH=$((CREATED_AT_EPOCH + 2592000))
		EXPIRES_AT=$(date -u -d "@$EXPIRES_AT_EPOCH" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date -u +"%Y-%m-%dT%H:%M:%SZ")
	fi

	log "WARP registration successful!"
	log "IPv4: $INTERFACE_IPV4, IPv6: $INTERFACE_IPV6, Endpoint: $ENDPOINT_HOST"

	# Configure OpenWrt UCI Network
	log "Updating UCI network configuration..."
	uci -q delete network.warp
	uci set network.warp=interface
	uci set network.warp.proto='wireguard'
	uci set network.warp.private_key="$PRIVATE_KEY"
	uci set network.warp.mtu='1280'
	uci add_list network.warp.addresses="$INTERFACE_IPV4/32"
	[ -n "$INTERFACE_IPV6" ] && uci add_list network.warp.addresses="$INTERFACE_IPV6/128"

	uci -q delete network.warp_peer
	uci set network.warp_peer=wireguard_warp
	uci set network.warp_peer.route_allowed_ips='1'
	uci set network.warp_peer.public_key="$PEER_PUBLIC_KEY"
	uci set network.warp_peer.endpoint_host="$ENDPOINT_IP"
	uci set network.warp_peer.endpoint_port="$ENDPOINT_PORT"
	uci add_list network.warp_peer.allowed_ips='0.0.0.0/0'
	uci add_list network.warp_peer.allowed_ips='::/0'
	uci set network.warp_peer.persistent_keepalive='25'
	uci commit network

	# Configure Firewall
	configure_firewall

	# Store status in UCI
	uci set warp.main.enabled='1'
	uci set warp.status.status='connected'
	uci set warp.status.private_key="$PRIVATE_KEY"
	uci set warp.status.public_key="$PUBLIC_KEY"
	uci set warp.status.peer_public_key="$PEER_PUBLIC_KEY"
	uci set warp.status.endpoint="$ENDPOINT_HOST"
	uci set warp.status.ipv4="$INTERFACE_IPV4"
	uci set warp.status.ipv6="$INTERFACE_IPV6"
	uci set warp.status.created_at="$CREATED_AT"
	uci set warp.status.expires_at="$EXPIRES_AT"
	uci set warp.status.expires_at_epoch="$EXPIRES_AT_EPOCH"
	uci set warp.status.account_id="$ACCOUNT_ID"
	uci set warp.status.device_id="$DEVICE_ID"
	uci set warp.status.license_key="$LICENSE_KEY"
	uci commit warp

	# Reload network stack and enable cron service
	log "Reloading network service and setting up renewal service..."
	/etc/init.d/network reload >/dev/null 2>&1 || ubus call network reload >/dev/null 2>&1 || true
	/etc/init.d/warp enable >/dev/null 2>&1 || true
	/etc/init.d/warp start >/dev/null 2>&1 || true

	# Bring up interface
	log "Bringing up WireGuard interface 'warp'..."
	ifup warp
}

do_disable() {
	log "Disabling Cloudflare WARP..."
	ifdown warp 2>/dev/null || true

	remove_firewall

	uci -q delete network.warp
	uci -q delete network.warp_peer
	uci commit network

	/etc/init.d/network reload >/dev/null 2>&1 || true

	uci set warp.main.enabled='0'
	uci set warp.status.status='disabled'
	uci commit warp

	log "Cloudflare WARP disabled successfully."
}

do_status() {
	local enabled status_str expires_at_epoch now time_remaining
	enabled=$(uci -q get warp.main.enabled || echo "0")
	status_str=$(uci -q get warp.status.status || echo "disabled")
	expires_at_epoch=$(uci -q get warp.status.expires_at_epoch || echo "0")
	now=$(date +%s)

	if [ "$expires_at_epoch" -gt 0 ] && [ "$expires_at_epoch" -gt "$now" ]; then
		time_remaining=$((expires_at_epoch - now))
	else
		time_remaining=0
	fi

	cat <<EOF
{
	"enabled": "$enabled",
	"status": "$status_str",
	"ipv4": "$(uci -q get warp.status.ipv4)",
	"ipv6": "$(uci -q get warp.status.ipv6)",
	"endpoint": "$(uci -q get warp.status.endpoint)",
	"created_at": "$(uci -q get warp.status.created_at)",
	"expires_at": "$(uci -q get warp.status.expires_at)",
	"expires_at_epoch": "$expires_at_epoch",
	"time_remaining_seconds": "$time_remaining"
}
EOF
}

case "$1" in
	register|enable)
		do_register
		;;
	disable)
		do_disable
		;;
	renew)
		log "Automated WARP key renewal triggered."
		do_register
		;;
	status)
		do_status
		;;
	*)
		echo "Usage: $0 {enable|disable|renew|status}"
		exit 1
		;;
esac
