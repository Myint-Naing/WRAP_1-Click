#!/bin/sh /etc/rc.common
# Init script for Cloudflare WARP auto-renewal service

START=99
STOP=10

CRON_FILE="/etc/crontabs/root"
CRON_JOB="0 3 * * * /usr/bin/warp-renew >/dev/null 2>&1"

setup_cron() {
	if [ -f "$CRON_FILE" ]; then
		grep -q "/usr/bin/warp-renew" "$CRON_FILE" || echo "$CRON_JOB" >> "$CRON_FILE"
	else
		mkdir -p /etc/crontabs
		echo "$CRON_JOB" > "$CRON_FILE"
	fi
	/etc/init.d/cron reload >/dev/null 2>&1 || /etc/init.d/cron restart >/dev/null 2>&1 || true
}

remove_cron() {
	if [ -f "$CRON_FILE" ]; then
		sed -i '\|/usr/bin/warp-renew|d' "$CRON_FILE"
		/etc/init.d/cron reload >/dev/null 2>&1 || true
	fi
}

start() {
	setup_cron
	# Check renewal status on boot
	/usr/bin/warp-renew >/dev/null 2>&1 &
}

stop() {
	remove_cron
}

reload() {
	setup_cron
}
